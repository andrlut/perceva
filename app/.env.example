# Expo only inlines env vars prefixed with EXPO_PUBLIC_
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxx

# Google Sign-In: the WEB application OAuth client ID from Google Cloud
# Console (NOT the Android one). Leave empty to hide the Google button —
# it self-disables when this is missing. See docs/google-signin-setup.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
